# Server Configuration
PORT=3001
NODE_ENV=development

# Casper Network
CASPER_NODE_URL=http://localhost:11101/rpc
CASPER_NETWORK_NAME=casper-test

# Contract Addresses (update after deployment)
VAULT_CONTRACT_HASH=hash-xxxxx
POSITION_MANAGER_CONTRACT_HASH=hash-xxxxx
MARKET_FACTORY_CONTRACT_HASH=hash-xxxxx
ORACLE_CONTRACT_HASH=hash-xxxxx
SETTLEMENT_CONTRACT_HASH=hash-xxxxx
LIQUIDITY_POOL_CONTRACT_HASH=hash-xxxxx
GOVERNANCE_CONTRACT_HASH=hash-xxxxx
YIELD_FARMING_CONTRACT_HASH=hash-xxxxx

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# API Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_PORT=3002
WS_HEARTBEAT_INTERVAL=30000

# Logging
LOG_LEVEL=info
